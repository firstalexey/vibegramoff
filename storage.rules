rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
//  VibeGram — правила Firebase Storage
//  Вкладка «Storage → Правила» → вставить → «Опубликовать».
//
//  Сюда уезжают: файлы и медиа больше 500 КБ (vibegram/<username>/…)
//  и «тяжёлые» документы больше ~700 КБ JSON (vibegram/bigdocs/…).
//  Если Storage не включить — приложение продолжит работать, но большие файлы
//  останутся только на том устройстве, откуда их отправили.
// ═══════════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {
    match /vibegram/{allPaths=**} {
      allow read: if true;      // ссылки должны открываться у собеседника
      allow write: if true;     // тестовый режим

      // Строгий вариант:
      // allow read: if request.auth != null;
      // allow write: if request.auth != null
      //   && request.resource.size < 50 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
